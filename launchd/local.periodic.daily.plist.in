<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered from a template by scripts/install.sh, which fills in the home folder. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.periodic.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>@HOME@/.local/bin/periodic-run</string>
        <string>daily</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>15</integer></dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.local/bin:/opt/local/bin:/opt/local/sbin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/periodic/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/periodic/launchd.log</string>
</dict>
</plist>
