<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered from a template by scripts/install.sh, which fills in the home folder. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.health-alert</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>@HOME@/Applications/Health Alert.app/Contents/MacOS/applet</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/health-alert.log</string>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/health-alert.log</string>
	<key>StartInterval</key>
	<integer>600</integer>
</dict>
</plist>
