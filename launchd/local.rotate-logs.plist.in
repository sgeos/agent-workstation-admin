<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered from a template by scripts/install.sh, which fills in the home folder. -->
<!--
  Rotate logs that long-running services hold open, daily at 04:40, by
  copying and then truncating. See ~/.local/bin/rotate-logs. Logs that each
  run opens afresh are rotated by newsyslog through /etc/newsyslog.d/local.conf.
  A missed run, as during sleep, runs once at the next wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.rotate-logs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@HOME@/.local/bin/rotate-logs</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/rotate-logs.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/rotate-logs.log</string>
</dict>
</plist>
