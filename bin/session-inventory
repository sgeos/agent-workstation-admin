#!/usr/bin/env python3
"""List the harness sessions running on this machine, read-only.

Run as: session-inventory, or python3 -I bin/session-inventory

It prints one tab-separated row per running session: harness, name, session or
thread id, harness version, model, reasoning effort, status and working
directory. It is meant for keeping a hand-maintained table of sessions current,
for example before a planned restart, so that each session can be resumed
afterwards. It never writes anywhere.

Sources, all read-only:
- Claude Code: ~/.claude/sessions/<pid>.json for running sessions, and the tail
  of each transcript, ~/.claude/projects/*/<id>.jsonl, for the model and effort
  of the latest main-thread reply. A session file whose pid is gone is skipped.
- Codex: running `codex resume [--cd DIR] ID` processes, joined to the threads
  table of ~/.codex/state_5.sqlite, opened read-only, for name, model, effort
  and version. A fresh `codex --cd DIR` session is matched to the thread
  created in DIR within five minutes of the process starting, and one that
  cannot be matched is listed as "unmatched" with its directory. The table and
  file name, state_5.sqlite, are those of the Codex versions this was written
  against, and may change in later versions.
- Grok Build: ~/.grok/active_sessions.json, with entries whose pid is gone
  skipped, and each session's summary.json for its title, model and effort.
  Grok's version is not recorded per session, so it prints as "?".

Never read here: auth.json files, the .key files beside session records, or
any credential. Transcripts are read only for the model and effort fields.

Failure modes: a source that cannot be read is reported on standard error and
skipped, so one broken source does not hide the others. Exit status is 0 when
every source was read and 1 otherwise.
"""
import glob
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
TAIL_BYTES = 6_000_000  # transcript bytes read from the end
problems = 0


def warn(msg):
    global problems
    problems += 1
    print(f"session-inventory: {msg}", file=sys.stderr)


def alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def short(path):
    return path.replace(HOME, "~", 1) if path.startswith(HOME) else path


def claude_model_effort(session_id):
    paths = glob.glob(f"{HOME}/.claude/projects/*/{session_id}.jsonl")
    if not paths:
        return "?", "?"
    model = effort = "?"
    with open(paths[0], "rb") as f:
        f.seek(0, 2)
        f.seek(max(0, f.tell() - TAIL_BYTES))
        lines = f.read().decode("utf-8", "replace").splitlines()
    for line in lines:
        if '"type":"assistant"' not in line:
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("isSidechain"):
            continue
        m = (rec.get("message") or {}).get("model")
        if m and m != "<synthetic>":
            model = m
        if isinstance(rec.get("effort"), str):
            effort = rec["effort"]
    return model, effort


def claude_rows():
    rows = []
    for path in sorted(glob.glob(f"{HOME}/.claude/sessions/*.json")):
        try:
            with open(path) as f:
                s = json.load(f)
        except (OSError, ValueError) as e:
            warn(f"cannot read {short(path)}: {e}")
            continue
        if not alive(s.get("pid")):
            continue
        model, effort = claude_model_effort(s.get("sessionId", ""))
        rows.append(("Claude Code", s.get("name") or "?", s.get("sessionId") or "?",
                     s.get("version") or "?", model, effort, s.get("status") or "?",
                     short(s.get("cwd") or "?")))
    return rows


UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def codex_package_json():
    """The package.json of the installed Codex npm package, or None.

    npm installs `codex` as a link to <prefix>/lib/node_modules/@openai/codex/
    bin/codex.js, so the package is found by resolving the link on PATH, which
    works for any npm prefix. SESSION_INVENTORY_CODEX_PKG overrides the search.
    """
    override = os.environ.get("SESSION_INVENTORY_CODEX_PKG")
    if override:
        return override
    found = shutil.which("codex")
    if not found:
        return None
    pkg = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(found))),
                       "package.json")
    try:
        with open(pkg) as f:
            if json.load(f).get("name") != "@openai/codex":
                return None
    except (OSError, ValueError):
        return None
    return pkg


def codex_running_version(start):
    """The Codex version a process started at START is running, or a hint.

    A resumed thread keeps the cli_version it was created with, so the threads
    table cannot say what runs now. A process runs the build installed when it
    started, so a process started after the current install runs the current
    version; an older one prints as "<= current".
    """
    pkg = codex_package_json()
    if pkg is None:
        return "?"
    try:
        with open(pkg) as f:
            current = json.load(f).get("version", "?")
        installed_at = os.stat(pkg).st_mtime
    except (OSError, ValueError):
        return "?"
    if start is None:
        return f"<= {current}"
    return current if start >= installed_at else f"<= {current}"


def codex_rows():
    # LC_ALL=C makes lstart English, so it parses regardless of the user's locale.
    try:
        out = subprocess.run(["ps", "-axo", "pid=,lstart=,command="], capture_output=True,
                             text=True, check=True, env={**os.environ, "LC_ALL": "C"}).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        warn(f"cannot list processes: {e}")
        return []
    procs = []
    for line in out.splitlines():
        m = re.search(r"/codex (resume|--cd)\b(.*)$", line)
        if not m or "app-server" in line:
            continue
        start = None
        sm = re.match(r"\s*\d+\s+(\w{3} \w{3}\s+\d+ \d\d:\d\d:\d\d \d{4})", line)
        if sm:
            try:
                start = time.mktime(time.strptime(" ".join(sm.group(1).split()),
                                                  "%a %b %d %H:%M:%S %Y"))
            except ValueError:
                start = None
        args = m.group(2).split()
        cwd = ref = None
        if m.group(1) == "--cd" and args:
            cwd = args[0]
        elif "--cd" in args:
            i = args.index("--cd")
            cwd = args[i + 1] if i + 1 < len(args) else None
            args = args[:i] + args[i + 2:]
        if m.group(1) == "resume" and args:
            ref = args[-1]  # a thread id, or a thread name
        procs.append((ref, cwd, start))
    if not procs:
        return []
    db = f"{HOME}/.codex/state_5.sqlite"
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    except sqlite3.Error as e:
        warn(f"cannot open {short(db)}: {e}")
        con = None
    cols = "id, name, model, reasoning_effort, cwd"
    rows = []
    for ref, cwd, start in procs:
        rec = None
        try:
            if con is not None and ref and UUID_RE.match(ref):
                rec = con.execute(f"select {cols} from threads where id = ?", (ref,)).fetchone()
            elif con is not None and ref:
                # `codex resume NAME`: the most recently updated thread of that name.
                rec = con.execute(f"select {cols} from threads where name = ? "
                                  "order by updated_at_ms desc limit 1", (ref,)).fetchone()
                if rec is None and cwd and start is not None:
                    # The thread was renamed after this process resumed it under
                    # its old name. Accept the match only when exactly one thread
                    # in that directory was updated since the process started,
                    # so two lines sharing a checkout are never confused.
                    found = con.execute(f"select {cols} from threads where cwd = ? and "
                                        "updated_at_ms >= ?",
                                        (os.path.expanduser(cwd), int(start * 1000))).fetchall()
                    rec = found[0] if len(found) == 1 else None
            elif con is not None and cwd and start is not None:
                # A fresh `codex --cd DIR PROMPT`: the thread created in that
                # directory within five minutes of the process starting.
                full = os.path.expanduser(cwd)
                rec = con.execute(f"select {cols} from threads where cwd = ? and "
                                  "created_at_ms between ? and ? order by created_at_ms limit 1",
                                  (full, int((start - 5) * 1000), int((start + 300) * 1000))).fetchone()
        except sqlite3.Error as e:
            warn(f"codex thread lookup failed: {e}")
        version = codex_running_version(start)
        if rec:
            tid, name, model, effort, tcwd = rec
            rows.append(("Codex", name or "unnamed", tid, version, model or "?",
                         effort or "?", "running", short(tcwd or cwd or "?")))
        else:
            rows.append(("Codex", "unmatched", ref or "?", version, "?", "?", "running",
                         short(cwd or "?")))
    if con is not None:
        con.close()
    return rows


def grok_rows():
    path = f"{HOME}/.grok/active_sessions.json"
    if not os.path.exists(path):
        return []
    try:
        with open(path) as f:
            sessions = json.load(f)
    except (OSError, ValueError) as e:
        warn(f"cannot read {short(path)}: {e}")
        return []
    rows = []
    for s in sessions if isinstance(sessions, list) else []:
        if not alive(s.get("pid")):
            continue
        sid = s.get("session_id") or "?"
        cwd = s.get("cwd") or "?"
        # The session's title, model and effort are in its summary.json, under a
        # folder named for the percent-encoded working directory. A title set
        # with /rename is the session's name.
        name = model = effort = "?"
        summaries = glob.glob(f"{HOME}/.grok/sessions/*/{sid}/summary.json")
        if summaries:
            try:
                with open(summaries[0]) as f:
                    summary = json.load(f)
                name = summary.get("generated_title") or "?"
                model = summary.get("current_model_id") or "?"
                effort = summary.get("reasoning_effort") or "?"
            except (OSError, ValueError) as e:
                warn(f"cannot read the Grok summary for {sid}: {e}")
        rows.append(("Grok", name, sid, "?", model, effort, "running", short(cwd)))
    return rows


def main():
    header = ("harness", "name", "id", "version", "model", "effort", "status", "cwd")
    print("\t".join(header))
    for row in claude_rows() + codex_rows() + grok_rows():
        print("\t".join(str(x) for x in row))
    return 0 if problems == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
