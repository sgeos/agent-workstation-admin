#!/bin/sh
# machine-status: a machine-wide resource status that agent sessions can read.
#
#   machine-status            print the current status; exit 0 ok, 1 elevated, 2 critical,
#                             3 stale or missing
#   machine-status --level    print only the level word, with the same exit status
#   machine-status sample     take a sample and write the status file (run by launchd)
#
# Why this exists. On 2026-11-08 eight Kani cbmc processes from one session took about
# 63 GB and drove swap from 6 to 26 GB in 40 minutes. The session could not see this:
# its sandbox refused ps, and even sysctl is refused in most agent sandboxes. The
# operator prefers that sessions see the machine's state and act on it, by waiting,
# pausing or lowering their own parallelism, over hard caps on what they may run. So
# an unsandboxed LaunchAgent samples once a minute and writes a plain text file that
# any session may read. Health Alert, every ten minutes, still alerts the operator.
#
# The status file is key=value lines, then a table of the largest sessions and the
# largest processes. Memory per process is top's MEM column, the footprint including
# compressed and swapped pages, because resident size falls exactly when memory is
# short. A session is found by walking each process's parent chain to a Claude Code,
# Codex or Grok process; Claude Code names come from ~/.claude/sessions/<pid>.json.
#
# Levels, chosen so that each reason can be checked against the file:
#   critical  kernel pressure level 4; or the data volume has under 20 GB free; or at
#             the current swap growth the data volume fills in under 60 minutes
#   elevated  kernel pressure level 2; or swap is growing faster than 200 MB a minute;
#             or swap use is 16 GB or more; or the data volume has under 50 GB free
#   ok        none of the above
# A reader treats a file older than three minutes as stale, because the sampler may
# have stopped.
#
# Settings, from the environment: MACHINE_STATUS_DIR, MACHINE_STATUS_HISTORY_LINES,
# MACHINE_STATUS_STALE_SECONDS, MACHINE_STATUS_TOP, MACHINE_STATUS_DATA_VOLUME,
# MACHINE_STATUS_SCRATCH_VOLUME and MACHINE_STATUS_PLAYBOOK. The thresholds that
# decide the level are fixed above, so that every reader judges by the same rules.
#
# Failure modes. A measurement that cannot be read is written as "-" and takes no part
# in the level, rather than counting as healthy or as a breach; the reasons line says
# which were missing. The file is replaced atomically, so a reader never sees half a
# sample. Trust boundary: every input is local command output, and process command
# lines appear only as text in the file.

set -u

STATE_DIR=${MACHINE_STATUS_DIR:-${HOME}/.local/state/machine-status}
STATUS_FILE=${STATE_DIR}/status
HISTORY_FILE=${STATE_DIR}/history
HISTORY_LINES=${MACHINE_STATUS_HISTORY_LINES:-1440}
STALE_SECONDS=${MACHINE_STATUS_STALE_SECONDS:-180}
DATA_VOLUME=${MACHINE_STATUS_DATA_VOLUME:-/System/Volumes/Data}
# An optional second volume for build output. When it is absent, its free space
# is written as "-" and takes no part in the level.
SCRATCH_VOLUME=${MACHINE_STATUS_SCRATCH_VOLUME:-/Volumes/Scratch}
TOP_PROCESSES=${MACHINE_STATUS_TOP:-40}
# How a session should act on the level. It names no activity, on purpose.
PLAYBOOK=${MACHINE_STATUS_PLAYBOOK:-${HOME}/.local/share/machine-status/PLAYBOOK.md}

usage() {
    sed -n '3,7p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 64
}

# value KEY FILE prints the value of KEY= in FILE, or nothing.
value() {
    sed -n "s/^$1=//p" "$2" | head -n 1
}

free_gb() {
    df -k "$1" 2>/dev/null | awk 'NR == 2 { printf "%d", $4 / 1048576 }'
}

# session_table writes "pid<TAB>session" for every process whose ancestry reaches an
# agent harness. It reads ps once and walks parent links in awk.
session_table() {
    ps -axo pid=,ppid=,command= 2>/dev/null | awk -v sessions="${HOME}/.claude/sessions" '
        {
            pid = $1; ppid[pid] = $2
            $1 = ""; $2 = ""; sub(/^  /, ""); cmd[pid] = $0
        }
        function label(p,    c, f, line, id) {
            c = cmd[p]
            if (c ~ /(^|\/)codex( |$)/ && c ~ / resume /) {
                id = c; sub(/.* resume /, "", id); sub(/ .*/, "", id)
                return "codex " substr(id, 1, 13)
            }
            if (c ~ /(^|\/)codex( |$)/ && c ~ / (-C|--cd) /) {
                id = c; sub(/.* (-C|--cd) /, "", id); sub(/ .*/, "", id); sub(/.*\//, "", id)
                return "codex in " id
            }
            if (c ~ /(^|\/)grok( |$)/) {
                id = c; sub(/.*--resume /, "", id); sub(/ .*/, "", id)
                return "grok " substr(id, 1, 13)
            }
            if (c ~ /^claude( |$)/ || c ~ /\/claude\/versions\/[0-9.]+( |$)/) {
                f = sessions "/" p ".json"
                if ((getline line < f) > 0) {
                    close(f)
                    if (match(line, /"name":"[^"]*"/))
                        return substr(line, RSTART + 8, RLENGTH - 9)
                }
                return "claude pid " p
            }
            return ""
        }
        END {
            for (p in ppid) {
                q = p; depth = 0; found = ""
                while (q != "" && q != "0" && q != "1" && depth < 20) {
                    found = label(q)
                    if (found != "") break
                    q = ppid[q]; depth++
                }
                if (found != "") printf "%s\t%s\n", p, found
            }
        }'
}

# processes writes "mem_mb<TAB>pid<TAB>command" for the largest processes by footprint.
processes() {
    top -l 1 -o mem -n "$TOP_PROCESSES" -stats pid,mem,command 2>/dev/null | awk '
        /^PID/ { body = 1; next }
        body && NF >= 3 {
            m = $2; sub(/[+-]$/, "", m)
            unit = substr(m, length(m)); n = substr(m, 1, length(m) - 1) + 0
            if (unit == "G") n *= 1024; else if (unit == "K") n /= 1024
            else if (unit == "B") n /= 1048576; else if (unit != "M") n = m + 0
            pid = $1; $1 = ""; $2 = ""; sub(/^  /, "")
            printf "%d\t%s\t%s\n", n, pid, $0
        }'
}

sample() {
    mkdir -p "$STATE_DIR" || exit 1
    now=$(date +%s)
    stamp=$(date '+%Y-%m-%dT%H:%M:%S%z')

    pressure=$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null)
    swap=$(sysctl -n vm.swapusage 2>/dev/null)
    swap_total=$(printf '%s\n' "$swap" | sed -n 's/.*total = \([0-9.]*\)M.*/\1/p' | cut -d. -f1)
    swap_used=$(printf '%s\n' "$swap" | sed -n 's/.*used = \([0-9.]*\)M.*/\1/p' | cut -d. -f1)
    physmem=$(top -l 1 -n 0 2>/dev/null | sed -n 's/^PhysMem: //p')
    compressor_mb=$(printf '%s\n' "$physmem" | sed -n 's/.*, \([0-9]*\)\([MG]\) compressor.*/\1 \2/p' |
        awk '{ print ($2 == "G") ? $1 * 1024 : $1 }')
    unused_mb=$(printf '%s\n' "$physmem" | sed -n 's/.* \([0-9]*\)\([MGK]\) unused.*/\1 \2/p' |
        awk '{ print ($2 == "G") ? $1 * 1024 : ($2 == "K") ? int($1 / 1024) : $1 }')
    load1=$(sysctl -n vm.loadavg 2>/dev/null | awk '{ print $2 }')
    data_gb=$(free_gb "$DATA_VOLUME")
    scratch_gb=$(free_gb "$SCRATCH_VOLUME")

    # Swap growth since the previous sample, in MB a minute.
    rate=-
    if [ -f "$STATUS_FILE" ] && [ -n "$swap_used" ]; then
        prev_epoch=$(value epoch "$STATUS_FILE")
        prev_swap=$(value swap_used_mb "$STATUS_FILE")
        case "$prev_epoch$prev_swap" in
            *[!0-9]*|'') ;;
            *) elapsed=$((now - prev_epoch))
               [ "$elapsed" -gt 0 ] && rate=$(( (swap_used - prev_swap) * 60 / elapsed )) ;;
        esac
    fi
    minutes_to_full=-
    if [ "$rate" != - ] && [ "$rate" -gt 0 ] && [ -n "$data_gb" ]; then
        minutes_to_full=$(( data_gb * 1024 / rate ))
    fi

    level=ok
    reasons=
    raise() {
        if [ "$1" = critical ] || [ "$level" = ok ]; then level=$1; fi
        reasons="${reasons}${reasons:+; }$2"
    }
    missing=
    if [ -n "$pressure" ]; then
        [ "$pressure" -ge 4 ] && raise critical "kernel memory pressure is critical"
        [ "$pressure" -eq 2 ] && raise elevated "kernel memory pressure is at warning"
    else
        missing="${missing} pressure"
    fi
    if [ -n "$data_gb" ]; then
        if [ "$data_gb" -lt 20 ]; then raise critical "data volume has ${data_gb} GB free"
        elif [ "$data_gb" -lt 50 ]; then raise elevated "data volume has ${data_gb} GB free"; fi
    else
        missing="${missing} disk"
    fi
    if [ "$minutes_to_full" != - ] && [ "$minutes_to_full" -lt 60 ]; then
        raise critical "at the current swap growth the data volume fills in ${minutes_to_full} minutes"
    fi
    if [ "$rate" != - ] && [ "$rate" -gt 200 ]; then
        raise elevated "swap is growing by ${rate} MB a minute"
    fi
    if [ -n "$swap_used" ]; then
        [ "$swap_used" -ge 16384 ] && raise elevated "swap use is ${swap_used} MB"
    else
        missing="${missing} swap"
    fi
    [ -n "$missing" ] && reasons="${reasons}${reasons:+; }could not read:${missing}"

    tmp=$(mktemp "${STATE_DIR}/.status.XXXXXX") || exit 1
    owners=$(mktemp "${STATE_DIR}/.owners.XXXXXX") || { rm -f "$tmp"; exit 1; }
    session_table > "$owners"
    {
        printf 'time=%s\nepoch=%s\nlevel=%s\nreasons=%s\n' "$stamp" "$now" "$level" "${reasons:-none}"
        printf 'playbook=%s\n' "$PLAYBOOK"
        printf 'pressure_level=%s\n' "${pressure:--}"
        printf 'swap_used_mb=%s\nswap_total_mb=%s\nswap_rate_mb_per_min=%s\n' \
            "${swap_used:--}" "${swap_total:--}" "$rate"
        printf 'compressor_mb=%s\nunused_mb=%s\nload1=%s\n' \
            "${compressor_mb:--}" "${unused_mb:--}" "${load1:--}"
        printf 'data_free_gb=%s\nscratch_free_gb=%s\nminutes_to_disk_full=%s\n' \
            "${data_gb:--}" "${scratch_gb:--}" "$minutes_to_full"
        printf '\n# Largest sessions by the memory of their processes, MB\n'
        processes | awk -F '\t' -v owners="$owners" '
            BEGIN { while ((getline l < owners) > 0) { split(l, a, "\t"); who[a[1]] = a[2] } }
            { s = ($2 in who) ? who[$2] : "-"; total[s] += $1; if (s != "-") count[s]++
              line[NR] = sprintf("%7d  %-7s  %-28.28s  %s", $1, $2, s, $3) }
            END {
                for (s in total) if (s != "-") printf "%7d  %s (%d processes)\n", total[s], s, count[s] | "sort -rn | head -n 8"
                close("sort -rn | head -n 8")
                print "\n# Largest processes, MB  pid  session  command"
                for (i = 1; i <= NR && i <= 15; i++) print line[i]
            }'
    } > "$tmp"
    rm -f "$owners"
    mv -f "$tmp" "$STATUS_FILE"

    printf '%s level=%s pressure=%s swap_used_mb=%s rate=%s unused_mb=%s data_free_gb=%s\n' \
        "$stamp" "$level" "${pressure:--}" "${swap_used:--}" "$rate" "${unused_mb:--}" "${data_gb:--}" \
        >> "$HISTORY_FILE"
    if [ "$(wc -l < "$HISTORY_FILE")" -gt "$HISTORY_LINES" ]; then
        tail -n "$HISTORY_LINES" "$HISTORY_FILE" > "${HISTORY_FILE}.tmp" && mv -f "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
    fi
}

# read_status prints the file, or the level, and exits with the level's status.
read_status() {
    if [ ! -r "$STATUS_FILE" ]; then
        echo "machine-status: no status file at $STATUS_FILE; the sampler may not be installed" >&2
        exit 3
    fi
    epoch=$(value epoch "$STATUS_FILE")
    level=$(value level "$STATUS_FILE")
    age=$(( $(date +%s) - ${epoch:-0} ))
    if [ "$age" -gt "$STALE_SECONDS" ]; then
        if [ "$1" = level ]; then
            echo stale
        else
            echo "STALE: the last sample is ${age} seconds old, so the sampler may have stopped"
            cat "$STATUS_FILE"
        fi
        exit 3
    fi
    if [ "$1" = level ]; then echo "$level"; else cat "$STATUS_FILE"; fi
    case $level in
        ok) exit 0 ;;
        elevated) exit 1 ;;
        critical) exit 2 ;;
        *) exit 3 ;;
    esac
}

case ${1:-} in
    '') read_status full ;;
    --level) read_status level ;;
    sample) sample ;;
    -h|--help) usage ;;
    *) usage ;;
esac
