#!/usr/bin/env python3
"""List cargo-installed binaries that have a newer stable release on crates.io.

Read-only. Parses `cargo install --list` and asks the crates.io sparse index,
https://index.crates.io, for each crate's published versions. Prints one line
per crate as "name installed latest", only for crates with a newer stable
release. Crates installed from git or a local path are skipped, because their
version is not comparable with crates.io. Yanked and pre-release versions are
ignored.

Used by the weekly report ~/.local/libexec/periodic/weekly/320.updates. cargo
is taken from ~/.cargo/bin, where rustup installs it, or else from PATH.
Trust boundary: the index is fetched over HTTPS and only version strings are
read from it; nothing it returns is executed or installed.
Failure modes: a crate whose lookup fails is printed as "name installed ?" so
the report shows it rather than hiding it. Exit status is 0, or 1 when cargo
itself cannot be run.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request

INDEX = "https://index.crates.io"


def index_path(name):
    n = name.lower()
    if len(n) <= 2:
        return f"{len(n)}/{n}"
    if len(n) == 3:
        return f"3/{n[0]}/{n}"
    return f"{n[:2]}/{n[2:4]}/{n}"


def version_key(v):
    return tuple(int(p) if p.isdigit() else 0 for p in re.split(r"[.+]", v))


def main():
    cargo = os.path.expanduser("~/.cargo/bin/cargo")
    if not os.access(cargo, os.X_OK):
        cargo = shutil.which("cargo") or cargo
    try:
        out = subprocess.run([cargo, "install", "--list"], capture_output=True,
                             text=True, check=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError) as e:
        print(f"cargo-outdated-check: cannot run cargo: {e}", file=sys.stderr)
        return 1
    for line in out.splitlines():
        m = re.match(r"^(\S+) v(\S+?)(?: \((.+)\))?:$", line)
        if not m or m.group(3):
            continue
        name, installed = m.group(1), m.group(2)
        try:
            req = urllib.request.Request(f"{INDEX}/{index_path(name)}",
                                         headers={"User-Agent": "cargo-outdated-check"})
            with urllib.request.urlopen(req, timeout=20) as r:
                records = [json.loads(x) for x in r.read().decode().splitlines() if x]
        except Exception:  # report the failure in the output, never hide it
            print(f"{name} {installed} ?")
            continue
        stable = [r["vers"] for r in records if not r.get("yanked") and "-" not in r["vers"]]
        if not stable:
            continue
        latest = max(stable, key=version_key)
        if version_key(latest) > version_key(installed):
            print(f"{name} {installed} {latest}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
